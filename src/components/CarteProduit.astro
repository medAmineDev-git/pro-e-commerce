---
import { Image } from 'astro:assets';
import { gammeDe, image, type Produit } from '../lib/contenu';

interface Props {
  produit: Produit;
  /** Largeur affichée, pour que le navigateur choisisse la bonne taille d'image. */
  tailles?: string;
  rang?: number;
}

const { produit, tailles = '(min-width: 64rem) 25vw, (min-width: 40rem) 33vw, 50vw', rang = 0 } = Astro.props;
const gamme = gammeDe(produit);
const [principale, seconde] = produit.images;
---

<a class="carte" href={`/collection/${produit.slug}`} data-gamme={produit.gamme} data-reveler style={`--rang:${rang % 4}`}>
  <span class="carte__visuel">
    <Image
      src={image(principale)}
      alt={produit.nom}
      widths={[360, 540, 720, 960]}
      sizes={tailles}
      class="carte__image"
    />
    {
      seconde && (
        <Image
          src={image(seconde)}
          alt=""
          widths={[360, 540, 720, 960]}
          sizes={tailles}
          class="carte__image carte__image--seconde"
        />
      )
    }
    <span class="carte__minimum">Dès {produit.minimum} pièces</span>
  </span>
  <span class="carte__gamme">{gamme.nom}</span>
  <span class="carte__nom">{produit.nom}</span>
  <span class="carte__resume">{produit.resume}</span>
</a>

<style>
  .carte {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
    text-decoration: none;
    color: inherit;
  }

  .carte__visuel {
    position: relative;
    aspect-ratio: 4 / 5;
    overflow: hidden;
    background: var(--sable);
    margin-bottom: 0.6rem;
  }

  .carte__visuel :global(.carte__image) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 1.2s var(--doux), opacity 0.6s var(--doux);
  }

  .carte__visuel :global(.carte__image--seconde) {
    opacity: 0;
  }

  .carte:hover .carte__visuel :global(.carte__image) {
    transform: scale(1.04);
  }

  .carte:hover .carte__visuel :global(.carte__image--seconde) {
    opacity: 1;
  }

  /* Le minimum de commande, cousu comme une étiquette sur la photo. */
  .carte__minimum {
    position: absolute;
    left: 0.75rem;
    bottom: 0.75rem;
    padding: 0.35rem 0.7rem;
    background: var(--ecru);
    color: var(--encre);
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.02em;
    outline: 1px dashed color-mix(in srgb, var(--encre) 35%, transparent);
    outline-offset: -4px;
  }

  .carte__gamme {
    font-size: 0.6875rem;
    font-weight: 700;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--terracotta);
  }

  .carte__nom {
    font-family: var(--titre);
    font-size: 1.375rem;
    line-height: 1.15;
  }

  .carte__resume {
    font-size: 0.875rem;
    color: var(--encre-douce);
    line-height: 1.45;
  }
</style>
