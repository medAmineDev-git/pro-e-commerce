---
/**
 * Icônes au trait, dessinées pour le site : elles prennent la couleur du texte.
 */
interface Props {
  nom: 'fleche' | 'whatsapp' | 'telephone' | 'mail' | 'lieu' | 'horloge' | 'coche' | 'plus' | 'menu' | 'fermer' | 'aiguille' | 'retour';
  taille?: number;
  class?: string;
}

const { nom, taille = 20, class: classe } = Astro.props;
---

<svg
  class={classe}
  width={taille}
  height={taille}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="1.6"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  focusable="false"
>
  {nom === 'fleche' && <path d="M4 12h15m-6-6 6 6-6 6" />}
  {nom === 'retour' && <path d="M20 12H5m6-6-6 6 6 6" />}
  {
    nom === 'whatsapp' && (
      <>
        <path d="M12 3.2a8.8 8.8 0 0 0-7.6 13.2L3.2 20.8l4.5-1.2A8.8 8.8 0 1 0 12 3.2Z" />
        <path
          d="M8.9 8.3c.2-.5.5-.5.8-.5h.5c.2 0 .4 0 .6.5l.7 1.7c.1.2 0 .5-.1.6l-.5.6c.6 1.1 1.6 2.1 2.7 2.7l.6-.5c.2-.1.4-.2.6-.1l1.7.7c.3.1.5.3.5.6v.5c0 .3 0 .6-.5.8-.5.3-1.4.5-2.3.2a8.7 8.7 0 0 1-5.1-5.1c-.3-.9-.1-1.8.2-2.3Z"
          fill="currentColor"
          stroke="none"
        />
      </>
    )
  }
  {nom === 'telephone' && <path d="M5 4h3.5l1.7 4.3-2.2 1.4a11 11 0 0 0 6.3 6.3l1.4-2.2L20 15.5V19a1.5 1.5 0 0 1-1.6 1.5A16.5 16.5 0 0 1 3.5 5.6 1.5 1.5 0 0 1 5 4Z" />}
  {
    nom === 'mail' && (
      <>
        <rect x="3" y="5" width="18" height="14" rx="1.5" />
        <path d="m3.5 6 8.5 7 8.5-7" />
      </>
    )
  }
  {
    nom === 'lieu' && (
      <>
        <path d="M12 21s-7-6.2-7-11.5a7 7 0 0 1 14 0C19 14.8 12 21 12 21Z" />
        <circle cx="12" cy="9.5" r="2.5" />
      </>
    )
  }
  {
    nom === 'horloge' && (
      <>
        <circle cx="12" cy="12" r="8.5" />
        <path d="M12 7.5V12l3 2" />
      </>
    )
  }
  {nom === 'coche' && <path d="m5 12.5 4.5 4.5L19 7.5" />}
  {nom === 'plus' && <path d="M12 5v14M5 12h14" />}
  {nom === 'menu' && <path d="M3 7h18M3 12h18M3 17h12" />}
  {nom === 'fermer' && <path d="M6 6l12 12M18 6 6 18" />}
  {
    nom === 'aiguille' && (
      <>
        <path d="M19.5 4.5 7 17" />
        <ellipse cx="18.2" cy="5.8" rx="0.9" ry="2.2" transform="rotate(45 18.2 5.8)" />
        <path d="M7 17c-2 1.5-3.5 1.5-4 .5s.5-2 2.5-1.8c2.5.2 4.5 3 7.5 3 2 0 3-1 3.5-2" />
      </>
    )
  }
</svg>
