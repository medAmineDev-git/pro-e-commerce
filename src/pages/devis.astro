---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import Icone from '../components/Icone.astro';
import { gammes, image, insecables, lienTelephone, lienWhatsapp, produits, produitsDe, site, texteBrut, titre } from '../lib/contenu';

/*
 * La page « Demander un devis » du menu. Nous ne produisons que nos modèles :
 * le devis se demande depuis la fiche de chacun. Cette page explique comment,
 * rassure, et mène à la collection.
 */
const { devis } = site;
const message = `Bonjour ${site.marque.nom}, j'ai une question avant de choisir mes modèles.`;
---

<Base
  titre={devis.titre}
  description={texteBrut(devis.seoDescription)}
  ariane={[{ nom: 'Demande de devis', chemin: '/devis' }]}
  sansBarre
>
  <section class="tete conteneur">
    <div class="tete__texte">
      <p class="surtitre">{devis.surtitre}</p>
      <h1 set:html={titre(devis.titrePage)} />
      <p class="chapeau">{insecables(texteBrut(devis.texte))}</p>
      <div class="tete__boutons">
        <a class="bouton" href="/collection">{devis.bouton} <Icone nom="fleche" /></a>
        <a class="bouton bouton--contour" href={lienWhatsapp(message)} target="_blank" rel="noopener" data-whatsapp>
          <Icone nom="whatsapp" /> Une question&#8239;?
        </a>
      </div>
    </div>
    <figure class="tete__visuel">
      <Image src={image('atelier-pile.jpg')} alt="Vêtements pliés et prêts à expédier, à l'atelier" widths={[480, 800, 1200]} sizes="(min-width: 60rem) 40vw, 100vw" loading="eager" />
      <span class="tete__etiquette">Réponse sous 24 h</span>
    </figure>
  </section>

  <section class="section section--sable" aria-labelledby="titre-etapes">
    <div class="conteneur">
      <p class="surtitre">Comment ça marche</p>
      <h2 id="titre-etapes" class="bloc-titre">Quatre étapes, <em>un seul interlocuteur.</em></h2>
      <ol class="etapes">
        {
          devis.etapes.map((etape, rang) => (
            <li data-reveler style={`--rang:${rang}`}>
              <span class="etapes__point">{rang + 1}</span>
              <strong>{etape.titre}</strong>
              <span>{insecables(etape.texte)}</span>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <section class="section conteneur" aria-labelledby="titre-gammes">
    <div class="gammes__tete">
      <h2 id="titre-gammes" class="bloc-titre">Par où <em>commencer&#8239;?</em></h2>
      <a class="lien-fleche" href="/collection">Les {produits.length} modèles <Icone nom="fleche" taille={16} /></a>
    </div>
    <div class="gammes">
      {
        gammes.map((gamme, rang) => {
          const modeles = produitsDe(gamme.id);
          const minimum = Math.min(...modeles.map((modele) => modele.minimum));
          return (
            <a class="gamme" href={`/collection?gamme=${gamme.id}`} data-reveler style={`--rang:${rang}`}>
              <Image src={image(gamme.image)} alt="" widths={[360, 640]} sizes="(min-width: 60rem) 24vw, 45vw" />
              <strong>{gamme.nom}</strong>
              <span>{modeles.length} modèles · dès {minimum} pièces</span>
            </a>
          );
        })
      }
    </div>
  </section>

  <section class="section section--nuit" aria-labelledby="titre-contenu">
    <div class="conteneur contenu">
      <div>
        <h2 id="titre-contenu" class="bloc-titre" set:html={titre(devis.contenuTitre)} />
        <ul class="contenu__liste">
          {devis.contenu.map((point) => <li><span><Icone nom="coche" taille={16} /></span> {insecables(point)}</li>)}
        </ul>
        <a class="bouton" href="/collection">{devis.bouton} <Icone nom="fleche" /></a>
      </div>

      <div class="contenu__cotes">
        <div class="encart">
          <p class="encart__titre">{insecables(devis.plusieursTitre)}</p>
          <p>{insecables(devis.plusieurs)}</p>
        </div>
        <div class="encart encart--clair">
          <p class="encart__titre">{insecables(devis.questionTitre)}</p>
          <p>{insecables(devis.question)}</p>
          <a class="bouton bouton--whatsapp" href={lienWhatsapp(message)} target="_blank" rel="noopener" data-whatsapp>
            <Icone nom="whatsapp" /> Écrire sur WhatsApp
          </a>
          <a class="encart__lien" href={lienTelephone()}><Icone nom="telephone" taille={18} /> {site.marque.telephone}</a>
          <p class="encart__horaires"><Icone nom="horloge" taille={18} /> {site.marque.horaires}</p>
        </div>
      </div>
    </div>
  </section>
</Base>

<!-- Les anciens liens « /devis?modele=… » mènent au devis du modèle. -->
<script is:inline define:vars={{ slugs: produits.map((produit) => produit.slug) }}>
  const modele = new URLSearchParams(location.search).get('modele');
  if (modele && slugs.includes(modele)) location.replace(`/devis/${modele}`);
</script>

<style>
  .tete {
    display: grid;
    gap: 2.5rem;
    padding-top: clamp(3rem, 8vw, 6rem);
    padding-bottom: var(--section);
    align-items: center;
  }

  .tete__texte {
    display: grid;
    gap: 1.5rem;
  }

  .tete__texte .surtitre {
    margin-bottom: -0.25rem;
  }

  h1 {
    font-size: clamp(2.75rem, 6.5vw, 5.5rem);
    font-weight: 340;
    max-width: 14ch;
  }

  .tete__boutons {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }

  .tete__visuel {
    position: relative;
    margin: 0;
  }

  .tete__visuel :global(img) {
    width: 100%;
    aspect-ratio: 4 / 5;
    object-fit: cover;
    border-radius: 999px 999px 0 0;
  }

  /* Une étiquette cousue sur la photo, comme sur les cartes produit. */
  .tete__etiquette {
    position: absolute;
    left: -0.75rem;
    bottom: 2rem;
    padding: 0.7rem 1.1rem;
    background: var(--ecru);
    font-size: 0.875rem;
    font-weight: 700;
    outline: 1px dashed color-mix(in srgb, var(--encre) 35%, transparent);
    outline-offset: -5px;
    box-shadow: 0 10px 24px rgba(0, 0, 0, 0.12);
  }

  @media (min-width: 60rem) {
    .tete {
      grid-template-columns: 1.2fr 0.8fr;
      gap: 5rem;
    }
  }

  .bloc-titre {
    font-size: clamp(2rem, 4.5vw, 3.5rem);
    margin-bottom: 2.5rem;
  }

  /* ------------------------------------------------ étapes */

  .etapes {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 2rem;
  }

  .etapes li {
    position: relative;
    display: grid;
    gap: 0.5rem;
    padding-left: 3.75rem;
    color: var(--encre-douce);
  }

  .etapes strong {
    font-family: var(--titre);
    font-size: 1.4rem;
    font-weight: 420;
    line-height: 1.2;
    color: var(--encre);
  }

  .etapes__point {
    position: absolute;
    left: 0;
    top: -0.2rem;
    width: 2.6rem;
    height: 2.6rem;
    display: grid;
    place-items: center;
    border-radius: 50%;
    background: var(--terracotta);
    color: var(--ecru);
    font-weight: 800;
  }

  @media (min-width: 64rem) {
    .etapes {
      grid-template-columns: repeat(4, 1fr);
      gap: 2.5rem;
    }

    .etapes li {
      padding: 3.75rem 0 0;
    }

    .etapes__point {
      top: 0;
    }

    /* Un fil de couture relie les quatre étapes. */
    .etapes li:not(:last-child)::after {
      content: '';
      position: absolute;
      top: 1.3rem;
      left: 3.4rem;
      right: -1.75rem;
      height: 2px;
      background: repeating-linear-gradient(90deg, color-mix(in srgb, var(--encre) 30%, transparent) 0 6px, transparent 6px 11px);
    }
  }

  /* ------------------------------------------------ gammes */

  .gammes__tete {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
  }

  .gammes {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1.5rem 1rem;
  }

  .gamme {
    display: grid;
    gap: 0.35rem;
    text-decoration: none;
  }

  .gamme :global(img) {
    width: 100%;
    aspect-ratio: 4 / 5;
    object-fit: cover;
    margin-bottom: 0.5rem;
    transition: transform 1s var(--doux);
  }

  .gamme:hover :global(img) {
    transform: scale(1.03);
  }

  .gamme strong {
    font-family: var(--titre);
    font-size: 1.35rem;
    font-weight: 400;
  }

  .gamme span {
    font-size: 0.875rem;
    color: var(--encre-douce);
  }

  @media (min-width: 60rem) {
    .gammes {
      grid-template-columns: repeat(4, 1fr);
      gap: 1.5rem;
    }
  }

  /* ------------------------------------------------ contenu du devis */

  .contenu {
    display: grid;
    gap: 3.5rem;
    align-items: start;
  }

  @media (min-width: 64rem) {
    .contenu {
      grid-template-columns: 1.3fr 1fr;
      gap: 6rem;
    }
  }

  .contenu .bloc-titre :global(em) {
    color: #e08a5f;
  }

  .contenu__liste {
    list-style: none;
    margin: 0 0 2.5rem;
    padding: 0;
    display: grid;
  }

  .contenu__liste li {
    display: flex;
    align-items: flex-start;
    gap: 0.9rem;
    padding: 1rem 0;
    border-bottom: 1px dashed rgba(245, 240, 230, 0.2);
    color: #e6ddcf;
    font-size: 1.0625rem;
  }

  .contenu__liste li span {
    flex: none;
    width: 1.75rem;
    height: 1.75rem;
    display: grid;
    place-items: center;
    border-radius: 50%;
    background: var(--terracotta);
    color: var(--ecru);
  }

  .contenu__cotes {
    display: grid;
    gap: 1rem;
  }

  .encart {
    display: grid;
    gap: 0.9rem;
    justify-items: start;
    padding: 1.75rem;
    background: var(--nuit-douce);
    color: #c9bfb1;
  }

  .encart--clair {
    background: var(--ecru);
    color: var(--encre-douce);
  }

  .encart__titre {
    font-family: var(--titre);
    font-size: 1.5rem;
    color: var(--ecru);
  }

  .encart--clair .encart__titre {
    color: var(--encre);
  }

  .encart__lien,
  .encart__horaires {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    font-weight: 600;
    text-decoration: none;
    color: var(--encre);
  }

  .encart__horaires {
    font-weight: 500;
    font-size: 0.9375rem;
    color: var(--encre-douce);
  }

  .encart__lien :global(svg),
  .encart__horaires :global(svg) {
    color: var(--terracotta);
    flex: none;
  }
</style>
